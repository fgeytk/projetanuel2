POSTGRES_DB=quiz
POSTGRES_USER=quiz
POSTGRES_PASSWORD=change-this-database-password

# --- Compte administrateur (RBAC) ---
# L'admin est un utilisateur normal avec role='admin', créé au démarrage.
# Option A (recommandé) : hash généré avec  python backend/auth.py "ton-mot-de-passe"
# Option B (dev local uniquement) : ADMIN_PASSWORD en clair, hashé au démarrage.
ADMIN_PSEUDO=admin
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=change-this-admin-password

# Durée de session utilisateur (30 jours par défaut)
USER_SESSION_TTL_SECONDS=2592000

# false en HTTP local, true derrière HTTPS
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
