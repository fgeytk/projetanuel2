POSTGRES_DB=quiz
POSTGRES_USER=quiz
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate with: python backend/auth.py "replace-with-your-admin-password"
ADMIN_PASSWORD_HASH=pbkdf2_sha256:600000:4Sz6cM7SuVLbOQjveo8rPQ:V3mC70yXAN800Ok5WEmO6ozVH04W7kJK8N4UQLfwpjU
ADMIN_SESSION_TTL_SECONDS=28800

# Put true only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# In production requests are same-origin through Nginx, so this can stay empty.
CORS_ORIGINS=

# Keep 80 unless another reverse proxy is already installed on the VM.
PUBLIC_HTTP_PORT=80
