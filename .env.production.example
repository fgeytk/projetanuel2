POSTGRES_DB=quiz
POSTGRES_USER=quiz
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- Compte administrateur (RBAC) ---
# Obligatoire en prod. Hash généré avec : python backend/auth.py "ton-mot-de-passe"
# (jamais de mot de passe en clair en production)
ADMIN_PSEUDO=admin
ADMIN_PASSWORD_HASH=

USER_SESSION_TTL_SECONDS=2592000

# true dès que le site est servi en HTTPS (recommandé)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# En production les requêtes sont same-origin via Nginx : laisser vide.
CORS_ORIGINS=

# 80 sauf si un autre reverse proxy tourne déjà sur la VM.
PUBLIC_HTTP_PORT=80
LOG_LEVEL=INFO
